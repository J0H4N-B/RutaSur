# Copia este archivo a .env y ajusta los valores. El archivo .env no se sube al repositorio.

# Base de datos (opcional). Sin esta variable, o si la conexión falla, se usa SQLite en instance/logistica.db
# Para MySQL instala antes el driver: pip install pymysql
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/logistica

HOST=127.0.0.1
PORT=5000

# 1 activa el modo de depuración (solo en desarrollo)
FLASK_DEBUG=1

# 1 carga datos ficticios si la base está vacía; 0 la deja vacía
CARGAR_EJEMPLOS=1
